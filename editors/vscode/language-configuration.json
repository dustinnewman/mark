{
  "comments": { "lineComment": "//", "blockComment": ["<!--", "-->"] },
  "brackets": [["{", "}"], ["[", "]"], ["(", ")"]],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string"] },
    { "open": "`", "close": "`" },
    { "open": "$", "close": "$" }
  ],
  "surroundingPairs": [["{", "}"], ["[", "]"], ["(", ")"], ["\"", "\""], ["'", "'"], ["`", "`"], ["*", "*"], ["_", "_"], ["$", "$"]],
  "folding": { "markers": { "start": "^\\s*(?:if|for|fn)\\b.*\\{\\s*$|^\\s*<[A-Za-z][^>]*(?<!/)>\\s*$", "end": "^\\s*\\}|^\\s*</" } }
}
