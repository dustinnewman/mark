    "files": { "site/index.mark": "var id = 0\nvar msg = \"start\"\nvar w = 0\nvar box = null\nasync fn go() {\nlet t = (id += 1)\nmsg = \"measuring\"\nawait next()\nw = measure(box).w\nawait after(50)\nif t == id {\nmsg = \"done\"\n}\n}\n<div id=box ref={box} style=\"width:120px\">x</div>\n<p id=m>{msg}</p><p id=w>{w}</p>\n<button id=g onTap={go()} />\n" },
    "steps": [
      { "expect": { "#m": "start", "#w": "0" } },
      { "click": "#g" }, { "expect": { "#m": "measuring", "#w": "120" } },
      { "wait": 100 }, { "expect": { "#m": "done" } },
      { "observe": "#m" }, { "click": "#g" }, { "click": "#g" }, { "wait": 100 }, { "expect": { "#m": "done" } }, { "expectMutations": 2 }
    ]
