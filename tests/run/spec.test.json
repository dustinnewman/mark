  {
    "name": "run-26 matrix multiplier core",
    "files": { "site/index.mark": "var a = [[1,2],[3,4]]\nvar b = [[5,6],[7,8]]\nvar hovered = null\nvar aText = \"\"\nvar aTouched = false\nlet conformable = a[0].length == b.length\nlet product = conformable ? a.map(row => b[0].map((_, j) => row.reduce((s, v, k) => s + Number(v) * Number(b[k][j]), 0))) : null\nfn parseMatrix(text) {\nlet v = try(JSON.parse(text), null)\nif !Array.isArray(v) || v.length == 0 {\nreturn null\n}\nif v.every(x => Number.isFinite(x)) {\nreturn [v]\n}\nlet w = Array.isArray(v[0]) ? v[0].length : 0\nreturn w > 0 && v.every(r => Array.isArray(r) && r.length == w && r.every(Number.isFinite)) ? v : null\n}\nlet aParsed = parseMatrix(aText.trim())\nlet aError = aTouched && aText.trim() != \"\" && aParsed == null\n<table id=\"A\">\nfor row, i in a {\n<tr>\nfor _, j in row {\n<td class=\"trace\" if hovered?.i == i><input value=$a[i][j] /></td>\n}\n</tr>\n}\n</table>\nif conformable {\n<table id=\"P\">\nfor row, i in product {\n<tr>\nfor v, j in row {\n<td class=\"r\" class=\"trace\" if hovered?.i == i && hovered?.j == j onMouseenter={hovered = {i, j}} onMouseleave={hovered = null}>{v}</td>\n}\n</tr>\n}\n</table>\n} else {\n<p id=\"mm\">undefined</p>\n}\n<input id=\"at\" value=$aText onInput={aParsed && (a = aParsed)} onChange={aTouched = true} />\nif aError {\n<p id=\"err\">bad</p>\n}\n" },
    "steps": [
      { "expectMismatches": 0 },
      { "expectText": { "#P td.r": ["19", "22", "43", "50"] } },
      { "input": "#A tr:nth-child(1) td:nth-child(1) input", "value": "2" },
      { "expectText": { "#P td.r": ["24", "28", "43", "50"] } },
      { "get": { "a": [["2", 2], [3, 4]] } },
      { "mouseenter": "#P td.r", "nth": 1 },
      { "expectAttr": { "#P tr:nth-child(1) td:nth-child(2)": { "class": "r trace" }, "#P tr:nth-child(1) td:nth-child(1)": { "class": "r" }, "#A tr:nth-child(1) td:nth-child(1)": { "class": "trace" }, "#A tr:nth-child(1) td:nth-child(2)": { "class": "trace" }, "#A tr:nth-child(2) td:nth-child(1)": { "class": null } } },
      { "mouseleave": "#P td.r", "nth": 1 },
      { "expectCount": { ".trace": 0 } },
      { "input": "#at", "value": "[[1,0],[0,1]]" },
      { "expectText": { "#P td.r": ["5", "6", "7", "8"] } }, { "expect": { "#err": null } },
      { "input": "#at", "value": "[[1,2,3]]" },
      { "expect": { "#mm": "undefined", "#P": null } },
      { "input": "#at", "value": "nope" }, { "expect": { "#err": null } },
      { "change": "#at" }, { "expect": { "#err": "bad" } },
      { "input": "#at", "value": "[[1]]" }, { "expect": { "#err": null } }, { "expectCount": { "#A td": 1 } }
    ]
  },
